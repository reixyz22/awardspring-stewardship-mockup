# Copy to .env and fill in. .env is gitignored.

# Google Gemini key, used for the drafting step and the assistant only.
# Free tier is enough for this app. Read server-side in server/local/ so it is
# never shipped to the browser.
GEMINI_API_KEY=

# Base URL for the AwardSpring API.
# Points at the local mock by default. Swapping this to https://api.awardspring.com
# is intended to be the only change required to run against production, which is
# not possible from outside a customer institution. See README.
VITE_AWARDSPRING_BASE_URL=http://localhost:8787

# Not obtainable. Present so the client's auth path is exercised rather than skipped.
# The mock validates the header the same way their docs describe.
VITE_AWARDSPRING_API_KEY=mock_key_not_a_real_credential

# Port the mock server listens on.
MOCK_PORT=8787
